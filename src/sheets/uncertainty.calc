# Measurement uncertainty (GUM method)
# Each component: half-width ÷ divisor. Divisors: 1 for a standard deviation,
# 2 for ± at 95 % (k = 2), √3 rectangular (resolution, specs), √6 triangular.
u1 = 0.05/√3                # instrument resolution ±0.05, rectangular
u2 = 0.1/2                  # calibration certificate ±0.1 at k = 2
u3 = 0.02                   # drift, standard deviation

# Type A from repeated readings
x = {12.31, 12.36, 12.33, 12.35, 12.34}
n = len(x)
s = stdev(x)                # standard deviation
u4 = s/√n                   # standard uncertainty of the mean

uc = √(u1² + u2² + u3² + u4²)   # combined standard uncertainty
k = 2                       # coverage factor (2 ≈ 95 %, 3 ≈ 99.7 %)
U = k·uc                    # expanded uncertainty
mean(x)                     # result
rel = U/mean(x)·100         # relative, %
